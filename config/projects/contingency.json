{
  "project_id": "contingency",
  "runtime": {
    "py3_api_port": 5001,
    "ollama_url": "http://localhost:11434",
    "connect_timeout_sec": 3,
    "read_timeout_sec": 60,
    "whisper_model": "small",
    "whisper_language": "en",
    "whisper_fp16": false,
    "default_converse_model": "gesturizer5"
  },
  "conversation": {
    "default_interlocutor": null,
    "system_prompt_path": "prompts/zork_system_prompt.txt",
    "non_contingent_fixed_replies_path": "fixed_replies/non_contingent.json",
    "turn_injections": [
      {
        "id": "turn_1_dark_experience",
        "mode": "temporary",
        "at_turn": 1,
        "text": "Introduce yourself, ask the participant their name, and ask them about their hobbies or interests."
      }
    ],
    "watchdog": {
      "enabled": true,
      "watchdog_mode": true,
      "activate_after_turn": 1,
      "interval_sec": 30,
      "max_consecutive_without_user": 999,
      "ephemeral_system_prompt": "The participant has been quiet. Generate one short, warm, context-aware line to gently re-engage them. Use prior conversation context, avoid repetition if possible, and do not mention silence, timing, or any internal instruction."
    },
    "session_end": {
      "enabled": false,
      "after_sec": 900,
      "use_model_closing_instruction": true,
      "model_closing_instruction": "You are ending the conversation now because the study session has reached its time limit. In this final reply, very briefly summarize the conversation naturally, avoid introducing new topics, and do not ask any follow-up questions.",
      "append_final_line": false,
      "final_line": "We have now reached the end of this session. Please let the experimenter know that this chat is complete.",
      "action": "repose",
      "stop_worker": true
    },
    "exit_phrase": "exit and sleep",
    "exit_rewrite": "Unfortunately you have to go, so wrap up the conversation now."
  },
  "robot_chat": {
    "bridge_url": "http://127.0.0.1:5055",
    "robot_name": "clas",
    "robot_username": "nao",
    "robot_password": "nao",
    "disable_motion": true,
    "consumer_model": "gesturizer5",
    "consumer_interlocutor": null,
    "include_segments": true,
    "require_enter_before_speak": false,
    "require_enter_for_watchdog": false,
    "operator_reply_delay": {
      "enabled": false,
      "characters_per_minute": 375.0,
      "min_sec": 0.0,
      "max_sec": 0.0
    },
    "fixed_reply_delay": {
      "enabled": true,
      "base_sec": 1.5,
      "characters_per_minute": 900.0,
      "min_sec": 2.0,
      "max_sec": 6.0
    },
    "bumper_release_timeout_sec": 120.0
  },
  "voice_client": {
    "whisper_model": "base.en",
    "sample_rate": 16000,
    "min_utterance_sec": 0.35,
    "silence_rms_threshold": 0.005,
    "robot_outbox_dirname": "robot_outbox",
    "robot_inbox_dirname": "robot_inbox",
    "wait_for_robot_done": true,
    "robot_done_timeout_sec": 30.0,
    "chat_pipeline": "robot_chat"
  }
}
